{
  "name": "valheim-floor-planner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:install": "VALHEIM_INSTALL_TEST=1 vitest run src/gameData/valheim/extractCatalogue.test.ts",
    "test:assets": "VALHEIM_INSTALL_TEST=1 vitest run src/gameData/valheim/extractModels.test.ts",
    "test:world": "vitest run src/gameData/valheim/world/realWorld.test.ts src/gameData/valheim/terrain/realTerrain.test.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@typegpu/gl": "0.12.6",
    "@typegpu/three": "0.12.1",
    "immer": "^11.1.21",
    "jotai": "^2.20.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "typegpu": "0.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "@webgpu/types": "0.1.74",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-typegpu": "0.12.5",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
